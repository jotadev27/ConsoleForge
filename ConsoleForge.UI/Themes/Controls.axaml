<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource ForgeBackground}" />
        <Setter Property="FontFamily" Value="{StaticResource ForgeMono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ForgeText}" />
        <Setter Property="FontFamily" Value="{StaticResource ForgeMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.dim">
        <Setter Property="Foreground" Value="{StaticResource ForgeTextDim}" />
    </Style>

    <Style Selector="TextBlock.section">
        <Setter Property="Foreground" Value="{StaticResource ForgeTextDim}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style Selector="TextBlock.wordmark">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource ForgeText}" />
    </Style>

    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="{StaticResource ForgeAccent}" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource ForgePanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Border.bar">
        <Setter Property="Background" Value="{StaticResource ForgePanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeBorder}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Border.tableHeader">
        <Setter Property="Background" Value="{StaticResource ForgePanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontFamily" Value="{StaticResource ForgeMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource ForgeAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeAccent}" />
        <Setter Property="Foreground" Value="#12100E" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ForgeAccent}" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeAccent}" />
        <Setter Property="Foreground" Value="#12100E" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ForgeAccentHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeAccentHover}" />
        <Setter Property="Foreground" Value="#12100E" />
    </Style>

    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ForgeAccentPressed}" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeAccentPressed}" />
    </Style>

    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#3A2A1E" />
        <Setter Property="BorderBrush" Value="#3A2A1E" />
        <Setter Property="Foreground" Value="#6C6259" />
    </Style>

    <Style Selector="Path.glyph">
        <Setter Property="Stretch" Value="None" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style Selector="Button.windowbutton">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="33" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="Button.windowbutton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.windowbutton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2F3438" />
    </Style>

    <Style Selector="Button.windowbutton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#3D4348" />
    </Style>

    <Style Selector="Button.windowbutton.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ForgeError}" />
    </Style>

    <Style Selector="Button.rowaction">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.rowaction /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{StaticResource ForgePanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeBorderStrong}" />
    </Style>

    <Style Selector="Button.rowaction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2B3034" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeAccent}" />
    </Style>

    <Style Selector="Button.rowaction.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#3A1D19" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeError}" />
    </Style>

    <Style Selector="Button.rowaction.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ForgeError}" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeError}" />
    </Style>

    <Style Selector="Button.thumb">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.thumb /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="#0C0E10" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeBorderStrong}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Button.thumb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource ForgeAccent}" />
    </Style>

    <Style Selector="Button.thumb:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#141719" />
        <Setter Property="BorderBrush" Value="#282C30" />
    </Style>

    <Style Selector="ToggleButton.device">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{StaticResource ForgeMono}" />
    </Style>

    <Style Selector="ToggleButton.device /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{StaticResource ForgePanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeBorderStrong}" />
    </Style>

    <Style Selector="ToggleButton.device:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2B3034" />
        <Setter Property="BorderBrush" Value="#4A5156" />
    </Style>

    <Style Selector="ToggleButton.device:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#33200F" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeAccent}" />
    </Style>

    <Style Selector="ToggleButton.device:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#3D2712" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeAccentHover}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontFamily" Value="{StaticResource ForgeMono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontFamily" Value="{StaticResource ForgeMono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FontFamily" Value="{StaticResource ForgeMono}" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource ForgeMono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="22" />
    </Style>

    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource ForgeAccent}" />
    </Style>

    <Style Selector="ProgressBar /template/ Border#PART_Indicator">
        <Setter Property="Background" Value="{StaticResource ForgeAccent}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ProgressBar /template/ Border">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource ForgeMono}" />
    </Style>

    <Style Selector="ListBoxItem /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ListBox.devices ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style Selector="ListBox.devices ListBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ForgePanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ListBox.devices ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2B3034" />
        <Setter Property="BorderBrush" Value="#4A5156" />
    </Style>

    <Style Selector="ListBox.devices ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#33200F" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeAccent}" />
    </Style>

    <Style Selector="ListBox.devices ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#3D2712" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeAccentHover}" />
    </Style>

    <Style Selector="ListBox.queue ListBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="ListBox.queue ListBoxItem:nth-child(2n) /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ForgeRowAlt}" />
    </Style>

    <Style Selector="ListBox.queue ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#262B2F" />
    </Style>

    <Style Selector="ListBox.queue ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#2E2015" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="{StaticResource ForgeBorder}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,6" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{StaticResource ForgePanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource ForgeMono}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

</Styles>
